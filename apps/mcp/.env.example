# Required for both local HTTP and stdio modes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: AdPilot origin for MCP ad delivery status updates.
# Defaults to https://adpilot.kenoo.io in production and http://localhost:3001 locally.
MCP_ADPILOT_API_URL=

# Required only for local stdio mode. Use a short-lived Supabase user access token.
MCP_DEV_ACCESS_TOKEN=
